# Copy to .env (start_windows.bat does this for you). NEVER commit .env.
# These values live on the backend only. The dashboard (frontend) never sees them.

# ---- Supabase (server-side secret!) ----
SUPABASE_URL=https://tvcythqflvfbpxardrfh.supabase.co
# Supabase dashboard -> Project Settings -> API -> "service_role" key (or new "secret" key).
SUPABASE_SERVICE_KEY=
SUPABASE_TABLE=sensor_readings
# "supabase" for real use, "memory" to try the app with no database (data lost on restart)
STORE_BACKEND=supabase

# ---- MQTT ----
# Local development with the Mosquitto on your LAN:
MQTT_HOST=192.168.8.35
MQTT_PORT=1883
MQTT_TLS=false
# Cloud (TLS) example - HiveMQ Cloud / EMQX Cloud:
# MQTT_HOST=xxxxxxxx.s1.eu.hivemq.cloud
# MQTT_PORT=8883
# MQTT_TLS=true
MQTT_USERNAME=irrigation_device
MQTT_PASSWORD=
MQTT_TOPIC_ROOT=irrigation
MQTT_ENABLED=true
# Optional path to a CA file if your broker uses a private CA
MQTT_CA_CERT=

# ---- App ----
DEFAULT_DEVICE_ID=device01
SOIL_THRESHOLD=3300
OFFLINE_AFTER_SECONDS=30
STORE_INTERVAL_SECONDS=10
# Admin token, 16+ random characters. Generate: python -c "import secrets;print(secrets.token_urlsafe(32))"
ADMIN_TOKEN=
# Comma-separated origins allowed to call the API from a browser (only needed when the
# frontend is hosted on a different domain), e.g. https://irrigation.netlify.app
ALLOWED_ORIGINS=
SERVE_FRONTEND=true
PORT=5000
